# 第三方 LLM 配置（OpenAI 兼容 Chat Completions）
# 复制为 extract/llm.yaml 后填写。换厂商只改这里，不动代码。
# 注意：llm.yaml 含密钥，已在 .gitignore 中排除，不会被提交。
#
# 优先级：环境变量 > 本文件 > 默认值。
# 想让密钥不落盘，可只在本文件写 base_url/model，api_key 用环境变量 LLM_API_KEY 提供。

llm:
  base_url: https://your-provider/v1   # 兼容端点，需含 /v1
  api_key: sk-xxxx                      # 也可改用环境变量 LLM_API_KEY
  model: your-model-name               # 模型名由厂商定
  temperature: 0                       # 抽取要稳定，默认 0
  concurrency: 5                       # 并发数（同时在飞的请求上限）
  rpm: 0                               # 每分钟请求数上限（客户端限流），0=不限；按厂商配额设
  max_retries: 3
  timeout_s: 60

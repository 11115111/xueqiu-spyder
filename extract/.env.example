# 第三方 LLM（OpenAI 兼容 Chat Completions）配置示例
# 复制为 .env 或直接 export 到环境变量。换厂商只改这里，不动代码。

LLM_BASE_URL=https://your-provider/v1   # 兼容端点，需含 /v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=your-model-name                # 模型名由厂商定
LLM_TEMPERATURE=0                        # 抽取要稳定，默认 0
LLM_CONCURRENCY=5                        # 并发数，按厂商限速调
LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=60

# 发帖数据所在 DuckDB（默认 ./xueqiu.duckdb，与爬虫同库）
XUEQIU_DB=./xueqiu.duckdb
